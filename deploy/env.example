# Copy to /etc/algo/env and restrict permissions to the algo service user.
DATA_DIR=/var/lib/nsebot
REPO_DATA_DIR=/opt/nsebot/data
LIVE_TRADING=false
UI_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Configure these through Settings or provide them in this protected environment file.
KITE_API_KEY=
KITE_API_SECRET=
XAI_API_KEY=
ALERT_WEBHOOK=
